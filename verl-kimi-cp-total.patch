@@ -0,0 +1,43 @@
+from types import SimpleNamespace
+
+import pytest
+
+from verl.utils.kimi_cp_config import configure_kimi_post_fusion_cp
+
+
+def test_cp1_is_unchanged():
+    config = {"distributed": {"ulysses_parallel_size": 1}}
+    assert not configure_kimi_post_fusion_cp(config, SimpleNamespace(model_type="kimi_k3"))
+    assert config == {"distributed": {"ulysses_parallel_size": 1}}
+
+
+def test_install_complete_plan_idempotently():
+    config = {"distributed": {"ulysses_parallel_size": 2, "fully_shard_parallel_size": 4}}
+    hf = SimpleNamespace(model_type="kimi_k3")
+    assert configure_kimi_post_fusion_cp(config, hf)
+    assert configure_kimi_post_fusion_cp(config, hf)
+    plan = config["distributed"]["cp_plan"]
+    assert len(plan["ulysses_function_patches"]) == 2
+    assert len(plan["loss_function_patches"]) == 1
+    assert len(config["module_patches"]) == 1
+
+
+def test_conflicting_forward_is_rejected():
+    config = {"distributed": {"ulysses_parallel_size": 2, "fully_shard_parallel_size": 4}, "module_patches": [
+        {"target": "modeling_kimi_k3.KimiK3ForConditionalGeneration.forward", "replacement": "other.forward"}
+    ]}
+    with pytest.raises(ValueError, match="Conflicting"):
+        configure_kimi_post_fusion_cp(config, SimpleNamespace(model_type="kimi_k3"))
+
+
+@pytest.mark.parametrize("key", ["tensor_parallel_size", "kv_allgather_parallel_size"])
+def test_unsupported_hybrid_fails_before_model_build(key):
+    config = {"distributed": {"ulysses_parallel_size": 2, key: 2}}
+    with pytest.raises(ValueError):
+        configure_kimi_post_fusion_cp(config, SimpleNamespace(model_type="kimi_k3"))
+
+
+def test_cp_group_must_be_inside_fsdp_averaging_group():
+    config = {"distributed": {"ulysses_parallel_size": 4, "fully_shard_parallel_size": 2}}
+    with pytest.raises(ValueError, match="averaging group"):
+        configure_kimi_post_fusion_cp(config, SimpleNamespace(model_type="kimi_k3"))
