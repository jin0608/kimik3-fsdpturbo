+@pytest.mark.parametrize("maximum", [255, 256, 895])
+def test_full_r3_as_dict_int32_preserves_ids_and_weight_bits(maximum):
+    ids = torch.tensor([[[0, 1]], [[2, maximum]]], dtype=torch.int64)
+    weights = torch.tensor([[[0.25, 0.75]], [[0.5, 0.5]]], dtype=torch.bfloat16).float()
+    output = AgentLoopOutput(
+        prompt_ids=[101, 102],
+        response_ids=[11],
+        response_mask=[1],
+        routed_experts=ids,
+        routed_expert_weights=weights,
+        routed_experts_source_semantics=KIMI_FULL_MODEL_ROUTE_SEMANTICS,
+        metrics=AgentLoopMetrics(),
+    )
+    fields = output.as_dict()
+    assert fields["routed_experts"].dtype == torch.int32
+    assert torch.equal(fields["routed_experts"].long(), ids)
+    assert torch.equal(fields["routed_expert_weights"].view(torch.int32), weights.view(torch.int32))
+
