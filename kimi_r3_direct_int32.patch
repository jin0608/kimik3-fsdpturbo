+@pytest.mark.parametrize("maximum", [3, 895])
+def test_padding_uses_int32_without_small_id_uint8_branch(maximum):
+    from tensordict import TensorDict
+
+    from verl.utils import tensordict_utils as tu
+    from verl.workers.utils.padding import left_right_2_no_padding
+
+    ids = torch.tensor([[[[0, 1]], [[2, maximum]]]], dtype=torch.int64)
+    weights = torch.full(ids.shape, 0.5)
+    data = TensorDict(
+        {
+            "input_ids": torch.tensor([[101, 11]]),
+            "attention_mask": torch.ones(1, 2, dtype=torch.int64),
+            "response_mask": torch.ones(1, 1, dtype=torch.int64),
+            "position_ids": torch.tensor([[0, 1]]),
+            "routed_experts": ids,
+            "routed_expert_weights": weights,
+        },
+        batch_size=[1],
+    )
+    tu.assign_non_tensor_data(data, "routed_experts_transport_semantics", KIMI_FULL_MODEL_ROUTE_SEMANTICS)
+    result = left_right_2_no_padding(data)
+    assert result["routed_experts"].dtype == torch.int32
+    assert torch.equal(result["routed_experts"].values().long(), ids.flatten(0, 1))
+    assert torch.equal(result["routed_expert_weights"].values().view(torch.int32), weights.flatten(0, 1).view(torch.int32))
