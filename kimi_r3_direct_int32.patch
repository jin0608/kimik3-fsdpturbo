+@pytest.mark.parametrize("invalid", [-1, 2147483648])
+def test_full_r3_as_dict_rejects_int32_overflow(invalid):
+    output = AgentLoopOutput(
+        prompt_ids=[101],
+        response_ids=[11],
+        response_mask=[1],
+        routed_experts=torch.tensor([[[invalid]]], dtype=torch.int64),
+        routed_expert_weights=torch.ones(1, 1, 1),
+        routed_experts_source_semantics=KIMI_FULL_MODEL_ROUTE_SEMANTICS,
+        metrics=AgentLoopMetrics(),
+    )
+    with pytest.raises(ValueError, match="non-negative int32 expert IDs"):
+        output.as_dict()
+
