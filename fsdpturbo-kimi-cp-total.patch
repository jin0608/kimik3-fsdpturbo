+            continue
+        forward = inspect.unwrap(getattr(forward, "__func__", forward))
+        chunk_kda = getattr(forward, "__globals__", {}).get("chunk_kda")
+        if callable(chunk_kda):
+            return chunk_kda
+    raise RuntimeError(
+        f"KDA module {type(module).__module__}.{type(module).__name__} does not expose "
