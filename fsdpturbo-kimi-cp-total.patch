+class _GatherFusedHiddenStates(torch.autograd.Function):
+    """Replicated RL loss, sequence-sharded decoder, FSDP-averaged gradients.
+
+    Every CP rank computes the same full-sequence loss. Return only this
+    rank's sequence gradient, multiplied by CP size to compensate the later
+    FSDP gradient average over the CP ranks. Do not scale the replicated head.
+    """
+
+    @staticmethod
+    def forward(ctx, hidden_states, group):
+        ctx.group_size = dist.get_world_size(group)
+        ctx.rank = dist.get_rank(group)
+        ctx.local_length = hidden_states.shape[1]
+        parts = [torch.empty_like(hidden_states) for _ in range(ctx.group_size)]
+        dist.all_gather(parts, hidden_states.contiguous(), group=group)
+        return torch.cat(parts, dim=1)
+
+    @staticmethod
+    def backward(ctx, grad_output):
+        start = ctx.rank * ctx.local_length
+        grad = grad_output.narrow(1, start, ctx.local_length).contiguous()
+        return grad * ctx.group_size, None
+
+
+def gather_fused_sequence_hidden_states(hidden_states, group, complete_length):
+    """Gather hidden states, not vocabulary logits; remove only CP padding."""
+    if dist.get_world_size(group) == 1:
+        return hidden_states[:, :complete_length]
+    full = _GatherFusedHiddenStates.apply(hidden_states, group)
+    if complete_length > full.shape[1] or complete_length <= full.shape[1] - dist.get_world_size(group):
+        raise ValueError("Decoder hidden-state length does not match the post-fusion CP layout")
+    return full[:, :complete_length]
 
 
