+"""Actual KimiDeltaAttention + native fully_shard + real CP collectives.
+
+The optional model-dir fixture supplies the checkpoint configuration and the
+verbatim modeling source. CPU uses the project's actual small-op kernels;
+NPU uses the backend selected by that same modeling module.
+"""
+import copy
+from datetime import timedelta
+from functools import wraps
+import importlib
+import os
+from pathlib import Path
+import tempfile
+import types
+
+import pytest
+import torch
+import torch.distributed as dist
+from torch.distributed.device_mesh import init_device_mesh
+from torch.distributed.fsdp import fully_shard
+import torch.multiprocessing as mp
+from torch.utils.checkpoint import checkpoint
+
+from fsdp_turbo.distributed.context_parallel.batch import gather_fused_sequence_hidden_states
+from fsdp_turbo.modules.kda import _get_chunk_kda, get_ulysses_kda_forward
+from kimi_kda_real_loader import load_real_kimi_module
+
+
+def _real_model(modeling, device):
+    config = modeling.KimiLinearConfig(
+        hidden_size=8 if device.type == "cpu" else 256,
+        num_hidden_layers=1,
+        num_attention_heads=2 if device.type == "cpu" else 4,
+        linear_attn_config={
+            "short_conv_kernel_size": 3,
+            "head_dim": 4 if device.type == "cpu" else 128,
+            "num_heads": 2 if device.type == "cpu" else 4,
+            "kda_layers": [1], "full_attn_layers": [],
+        },
+    )
+    model = modeling.KimiDeltaAttention(config, layer_idx=0).to(device)
+    # KDA leaves dt_bias to checkpoint loading; use finite deterministic values
+    # when constructing a small randomly initialized module without weights.
+    with torch.no_grad():
+        model.dt_bias.fill_(0.1)
+    return model
+
+
+def _worker(rank, init_path, recompute, with_mask, compare_legacy):
+    device_type = os.environ.get("KIMI_KDA_TEST_DEVICE", "cpu")
+    if device_type == "npu":
+        import torch_npu  # noqa: F401
+        torch.npu.set_device(rank)
+        device = torch.device("npu", rank)
+        backend = "hccl"
+    else:
+        device = torch.device("cpu")
+        backend = "gloo"
+    dist.init_process_group(backend, init_method=f"file://{init_path}", rank=rank, world_size=2,
+                            timeout=timedelta(seconds=180))
+    try:
+        modeling = load_real_kimi_module()
+        torch.manual_seed(123)
+        reference = _real_model(modeling, device)
+        model = copy.deepcopy(reference)
+        original_forward = modeling.KimiDeltaAttention.forward
+        model.forward = types.MethodType(get_ulysses_kda_forward(original_forward, dist.group.WORLD), model)
+        fully_shard(model, mesh=init_device_mesh(device_type, (2,)))
+        assert type(model).__name__ == "FSDPKimiDeltaAttention"
+        assert type(model).__module__ != modeling.__name__
+
+        if compare_legacy:
+            # Exact old lookup logic: this must reproduce the production error
+            # after the actual fully_shard call, not after a fake class rename.
+            wrong_module = importlib.import_module(type(model).__module__)
+            assert not callable(getattr(wrong_module, "chunk_kda", None))
+
+        assert _get_chunk_kda(model, original_forward) is modeling.chunk_kda
+        assert _get_chunk_kda(model) is modeling.chunk_kda
+
+        seq = 8 if device_type == "cpu" else 128
+        hidden = reference.hidden_size
+        # Generate on CPU then copy so both ranks get bit-identical inputs.
+        complete_input = torch.randn(2, seq, hidden).to(device).requires_grad_(True)
+        reference_input = complete_input.detach().clone().requires_grad_(True)
+        complete_mask = None
+        if with_mask:
+            complete_mask = torch.ones(2, seq, dtype=torch.long, device=device)
+            complete_mask[1, -(2 if device_type == "cpu" else 32):] = 0
+        local_input = complete_input[:, rank*(seq//2):(rank+1)*(seq//2)].contiguous()
+        local_mask = None if complete_mask is None else complete_mask[:, rank*(seq//2):(rank+1)*(seq//2)]
+
+        def run(x):
+            return model(x, attention_mask=local_mask)
+
+        def autocast():
+            from contextlib import nullcontext
+            return torch.autocast("npu", dtype=torch.bfloat16) if device_type == "npu" else nullcontext()
+
+        with autocast():
+            actual_local = checkpoint(run, local_input, use_reentrant=False) if recompute else run(local_input)
+            actual = gather_fused_sequence_hidden_states(actual_local, dist.group.WORLD, seq)
+            expected = reference(reference_input, attention_mask=complete_mask)
+        atol = float(os.environ.get("KIMI_KDA_TEST_ATOL", "2e-6" if device_type == "cpu" else "1e-3"))
+        rtol = float(os.environ.get("KIMI_KDA_TEST_RTOL", "2e-4" if device_type == "cpu" else "1e-2"))
+        torch.testing.assert_close(actual, expected, atol=atol, rtol=rtol)
+        actual.float().square().mean().backward()
+        expected.float().square().mean().backward()
+        max_grad_error = 0.0
+        for name, parameter in model.named_parameters():
+            ref_parameter = dict(reference.named_parameters())[name]
+            assert parameter.grad is not None and ref_parameter.grad is not None, name
+            actual_grad = parameter.grad.full_tensor()
+            max_grad_error = max(max_grad_error, (actual_grad-ref_parameter.grad).abs().max().item())
+            torch.testing.assert_close(actual_grad, ref_parameter.grad, atol=atol, rtol=rtol,
+                                       msg=lambda msg: name + ": " + msg)
+        input_grad = complete_input.grad.clone()
+        dist.all_reduce(input_grad)
+        input_grad /= 2
+        torch.testing.assert_close(input_grad, reference_input.grad, atol=atol, rtol=rtol)
+        if rank == 0:
+            print(f"NATIVE_KDA_PASS device={device_type} recompute={recompute} mask={with_mask} "
+                  f"runtime_class={type(model).__module__}.{type(model).__name__} "
+                  f"kernel={modeling.chunk_kda.__module__}.{modeling.chunk_kda.__name__} "
+                  f"max_output_abs={(actual-expected).abs().max().item():.9g} "
+                  f"max_parameter_grad_abs={max_grad_error:.9g}", flush=True)
+    finally:
+        dist.destroy_process_group()
+
+
+@pytest.mark.skipif(not os.environ.get("KIMI_KDA_TEST_MODEL_DIR"),
+                    reason="requires actual checkpoint remote-code files")
+@pytest.mark.parametrize("recompute", [False, True])
+@pytest.mark.parametrize("with_mask", [False, True])
+def test_real_kda_native_fsdp_cp_forward_backward(recompute, with_mask):
+    with tempfile.TemporaryDirectory() as directory:
+        mp.spawn(_worker, args=(str(Path(directory)/"init"), recompute, with_mask, True),
+                 nprocs=2, join=True)
+
+
+def test_original_forward_namespace_wins_and_decorators_unwrap():
+    selected = lambda: None
+    unrelated = lambda: None
+    namespace = {"chunk_kda": selected}
+    exec("def forward(self, x): return x", namespace)
+    original = namespace["forward"]
+    @wraps(original)
+    def decorated(*args, **kwargs):
+        return original(*args, **kwargs)
+    other_namespace = {"chunk_kda": unrelated}
+    exec("def forward(self, x): return x", other_namespace)
+    wrapped_type = type("FSDPKimiDeltaAttention", (torch.nn.Module,),
+                        {"forward": other_namespace["forward"], "__module__": "torch.distributed.fsdp"})
+    assert _get_chunk_kda(wrapped_type(), decorated) is selected
+    assert _get_chunk_kda(wrapped_type(), types.MethodType(decorated, wrapped_type())) is selected
+
+
+def test_missing_kernel_fails_without_backend_substitution():
+    class Missing(torch.nn.Module):
+        def forward(self, x):
+            return x
+    with pytest.raises(RuntimeError, match="original forward"):
+        _get_chunk_kda(Missing())
