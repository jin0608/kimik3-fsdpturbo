diff --git a/tests/unit_tests/distributed/expert_parallel/test_kimi_ep_uniform_fallback.py b/tests/unit_tests/distributed/expert_parallel/test_kimi_ep_uniform_fallback.py
new file mode 100644
--- /dev/null
+++ b/tests/unit_tests/distributed/expert_parallel/test_kimi_ep_uniform_fallback.py
@@ -0,0 +1,85 @@
+"""CPU metadata regression tests; these do not validate HCCL or NPU arithmetic."""
+import ast
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+import torch
+
+
+def _load_preprocess():
+    path = Path(__file__).resolve().parents[4] / 'fsdp_turbo/distributed/expert_parallel/dispatcher.py'
+    tree = ast.parse(path.read_text())
+    function = next(n for n in tree.body if isinstance(n, ast.FunctionDef) and n.name == 'dispatch_preprocess')
+    namespace = {'torch': torch}
+    exec(compile(ast.Module(body=[function], type_ignores=[]), str(path), 'exec'), namespace)
+    return namespace, namespace['dispatch_preprocess']
+
+
+@pytest.mark.parametrize('counts,expected', [
+    ([[2, 1, 0, 1], [0, 1, 0, 3]], True),  # Only one EP rank owns a globally empty expert.
+    ([[2, 1, 1, 0], [0, 1, 2, 1]], False),  # Per-source zeros are not globally empty experts.
+    ([[2, 0, 0, 0], [1, 0, 0, 0]], True),  # One EP rank receives no tokens at all.
+    ([[0, 0, 0, 0], [0, 0, 0, 0]], True),  # All token lists are empty.
+])
+def test_ep_decision_is_identical_and_existing_metadata_is_unchanged(monkeypatch, counts, expected):
+    namespace, preprocess = _load_preprocess()
+    counts = torch.tensor(counts, dtype=torch.int64)
+    ep_size, num_experts = counts.shape
+    rank_state = SimpleNamespace(rank=0)
+    monkeypatch.setattr(torch.distributed, 'get_world_size', lambda group: ep_size)
+    monkeypatch.setattr(torch.distributed, 'get_rank', lambda group: rank_state.rank)
+    calls = []
+
+    def gather(local, group):
+        torch.testing.assert_close(local, counts[rank_state.rank], rtol=0, atol=0)
+        calls.append(rank_state.rank)
+        return counts.flatten().clone(), None
+
+    namespace['gather_along_first_dim_expert_parallel'] = gather
+    # torch.histc CPU does not implement integer inputs. Exact small float IDs
+    # exercise the same count/split logic without requiring an NPU.
+    expert_ids = torch.arange(num_experts, dtype=torch.int64) % (num_experts // ep_size)
+    decisions = []
+    local_decisions = []
+    for rank in range(ep_size):
+        rank_state.rank = rank
+        routes = torch.repeat_interleave(torch.arange(num_experts), counts[rank]).float().reshape(-1, 1)
+        legacy = preprocess(None, routes, num_experts, expert_ids)
+        extended = preprocess(None, routes, num_experts, expert_ids, return_ep_has_empty_expert=True)
+        assert len(legacy) == 2  # Existing callers keep their two-value contract.
+        assert len(extended) == 3
+        for old_group, new_group in zip(legacy, extended[:2]):
+            for old, new in zip(old_group, new_group):
+                torch.testing.assert_close(old, new, rtol=0, atol=0)
+                assert old.dtype == new.dtype == torch.int64
+        flag = extended[2]
+        assert flag.dtype == torch.bool and flag.ndim == 0
+        assert not flag.requires_grad
+        decisions.append(bool(flag.item()))
+        local_decisions.append(bool((extended[0][0] == 0).any().item()))
+    assert decisions == [expected] * ep_size
+    assert len(calls) == 2 * ep_size  # One existing AllGather per preprocessing call.
+    if counts.tolist() == [[2, 1, 0, 1], [0, 1, 0, 3]]:
+        assert local_decisions == [False, True]  # The original divergent decision.
+
+
+def test_no_empty_expert_with_896_experts_and_16_ranks(monkeypatch):
+    namespace, preprocess = _load_preprocess()
+    counts = torch.zeros((16, 896), dtype=torch.int64)
+    # Every expert is selected once in the EP group, despite most matrix cells being zero.
+    for expert in range(896):
+        counts[expert % 16, expert] = 1
+    rank_state = SimpleNamespace(rank=0)
+    monkeypatch.setattr(torch.distributed, 'get_world_size', lambda group: 16)
+    monkeypatch.setattr(torch.distributed, 'get_rank', lambda group: rank_state.rank)
+    namespace['gather_along_first_dim_expert_parallel'] = lambda local, group: (counts.flatten().clone(), None)
+    expert_ids = torch.arange(896, dtype=torch.int64) % 56
+    for rank in range(16):
+        rank_state.rank = rank
+        routes = torch.nonzero(counts[rank], as_tuple=False).float()
+        indices, splits, flag = preprocess(None, routes, 896, expert_ids, return_ep_has_empty_expert=True)
+        assert not flag.item()
+        assert indices[0].tolist() == [1] * 56
+        assert splits[0].sum().item() == 56
+        assert splits[1].sum().item() == 56
